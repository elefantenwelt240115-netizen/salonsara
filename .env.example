# Required on Vercel. Generate a long random value; never expose it as NEXT_PUBLIC_*.
OWNER_SESSION_SECRET=

# Durable content storage (preferred names used by an Upstash integration).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: customize the Redis key when several sites share one database.
SITE_CONTENT_REDIS_KEY=
